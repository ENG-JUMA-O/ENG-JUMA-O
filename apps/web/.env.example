# Copy this file to ".env" and fill in the values you want to use.
# Anything left blank is simply hidden or disabled on the site.
# Only put PUBLIC values here: everything prefixed with VITE_ ends up in the browser bundle.

# Production URL, no trailing slash (used for canonical URLs, social cards, sitemap.xml)
VITE_SITE_URL=

# Base path. Leave blank for "/" (Vercel, Netlify, custom domains).
# For a GitHub Pages project site use "/your-repo-name/".
VITE_BASE_PATH=

# Contact details shown on the site
VITE_CONTACT_EMAIL=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# Buy Me a Coffee profile URL (the section and links stay hidden until this is set)
VITE_BUYMEACOFFEE_URL=

# EmailJS (contact form delivery). All three are required for the form to send.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Social sharing image, e.g. /images/og-image.png (1200x630 PNG or JPG placed in /public/images)
VITE_OG_IMAGE=
